# Newfound — environment configuration
#
# Copy this file to `.env.local` and fill in values.
# Vite exposes any var prefixed with VITE_ to the browser bundle.

# ⚠️  Direct-from-browser Claude calls.
#
# The "explain this section" chat panel calls the Anthropic API directly
# from the browser. This embeds the key in client JS and exposes it to
# anyone who can open devtools. Treat the key as throwaway / scoped /
# rate-limited; do not deploy with a production key.
#
# Get a key at https://console.anthropic.com/.
VITE_ANTHROPIC_API_KEY=

# Optional override of the Claude model used for the chat panel.
# Defaults to claude-sonnet-4-6.
# VITE_ANTHROPIC_MODEL=claude-sonnet-4-6
