Content-Type: text/css
Content-Transfer-Encoding: quoted-printable
Content-Location: https://library.ucsd.edu/_resources/css/structured-content/global-structured-styles.css

@charset "utf-8";

:root { --color-brand-accent-magenta: #d462ad; --color-brand-accent-orange:=
 #fc8900; --color-brand-accent-magenta-hover: #ca3f9b; --color-brand-accent=
-turquoise: #00c6d7; --color-brand-accent-sand: #f5f0e6; --color-brand-core=
-blue: #00629b; --color-brand-core-navy: #182b49; --color-brand-neutral-sto=
ne: #b6b1a9; --corner-radius-brand: 8px; --color-brand-core-yellow: #ffcd00=
; --brand-border: solid 1px; --brand-heading3-font: 400 1.5rem/1.5 "Roboto"=
; }

.grid {
  display: grid; gap: 10px;
  &.two-by-two { grid-template-columns: repeat(auto-fit, minmax(430px, 1fr)=
); }
  &.three-by-one { grid-template-columns: repeat(auto-fit, minmax(250px, 1f=
r)); }
  &.three-by-two { grid-template-columns: repeat(auto-fit, minmax(285px, 1f=
r)); }
  &.four-by-one { grid-template-columns: repeat(auto-fit, minmax(195px, 1fr=
)); }
}

.main-stack > * + :not(:nth-child(2)) { margin-block-start: 2rem; }

.stack > * + * { margin-block-start: 1rem; }

.flex-50-50 {
  display: flex; gap: 16px; flex-wrap: wrap;
  &.flex-50-50--space-between { flex-wrap: wrap; align-items: baseline; jus=
tify-content: space-between; }
  & section { flex-basis: calc(430.5px); }
}

@keyframes assetSlice {=20
  0% { opacity: 0; transform: translateY(0.5rem); }
  100% { opacity: 1; transform: translateY(0px); }
}

.search-animation { animation: 0.8s ease-out 0s 1 normal none running asset=
Slice; }

.visually-hidden { position: absolute; clip: rect(0px, 0px, 0px, 0px); widt=
h: 1px; height: 1px; margin: -1px; border: 0px; padding: 0px; overflow: hid=
den; }

.layout-hidden { display: none; }

.btn { font-size: 0.9375em; text-transform: uppercase; padding: 0.8em 1.5em=
; min-width: 200px; margin-bottom: 1em; letter-spacing: 0.08em; font-weight=
: 700; border-radius: var(--corner-radius-brand); font-family: inherit; tra=
nsition: 0.3s; border: 0px; white-space: normal; }

.btn--secondary {
  background-color: var(--color-brand-core-yellow); color: var(--color-bran=
d-core-navy);
  &:hover { background-color: var(--color-brand-core-navy); color: rgb(255,=
 255, 255); }
}

.bttn--search {
  border-width: medium; border-style: none; border-color: currentcolor; bor=
der-image: initial; flex: 0 0 min(20%, 90px); padding: 1rem; display: flex;=
 place-content: center; font-size: 1.75rem; color: rgb(255, 255, 255); bord=
er-top-left-radius: 0px; border-bottom-left-radius: 0px; background-color: =
var(--color-brand-accent-magenta);
  &:hover, &:focus { background-color: var(--color-brand-accent-magenta-hov=
er); }
}

li.card, .card, .tile {
  border-radius: var(--corner-radius-brand); overflow: clip; position: rela=
tive; border: 1px solid var(--color-brand-neutral-stone, #b6b1a9); transiti=
on: background-color 0.3s ease-in-out;
  & h3 { margin-block: 0px; }
  & img { display: inline-block; }
  & .tile__link-target, & .card__link-target { padding-block: 10px; display=
: block; color: rgb(255, 255, 255); text-decoration: none; }
  & a.card__link-target::after, & a.tile__link-target::after { inset: 0px; =
content: ""; min-height: 44px; min-width: 44px; position: absolute; }
  & .card__body, & .tile__body {
  padding-block-end: 0.5rem; text-wrap-style: pretty; height: fit-content;
  & a { text-decoration: none; }
  & span { font: var(--brand-heading3-font); padding-block: 10px; display: =
block; }
  & h3 { color: rgb(255, 255, 255); }
  & svg { height: 32px; width: 32px; }
}
  & .card__toolbar, & .tile__toolbar {
  position: relative; padding-block: 0px 1rem; padding-inline-start: 10px; =
display: flex; flex-wrap: wrap; gap: 0.5rem 1rem;
  &.toolbar--fill { background-color: var(--color-brand-core-navy); }
  & .tag { color: rgb(51, 51, 51); }
}
}

.featured-container { display: flex; flex-wrap: wrap; justify-content: cent=
er; gap: 0.5rem; padding-inline-start: 0px; }

.card.card--featured {
  .featured-container & { flex: 0 0 calc(280px); }
  &:hover, &:has(a.card__link-target:focus), &:has(a.tile__link-target:focu=
s) { background-color: var(--color-brand-accent-sand, #f5f0e6); }
  & .card--featured__body {
  & img { width: 100%; max-height: 300px; object-fit: cover; }
  color: rgb(255, 255, 255); background-color: var(--color-brand-core-navy)=
;
  & h3, & p, & span { margin-inline: 10px; }
  &.white-bg {
  background-color: initial;
  & h3 { color: var(--color-brand-core-blue, #00629b); }
  & p { color: initial; }
}
  &.spaces {
  & span { text-transform: uppercase; color: initial; font-size: 14px; font=
-weight: 600; padding-bottom: 0px; }
}
  & span, & a { color: rgb(255, 255, 255); }
}
}

.card.card--full-width {
  margin-block-end: 1rem;
  & .card--full-width__body {
  position: relative; padding: 20px; color: var(--color-brand-core-navy);
  & p, & span { color: var(--color-brand-core-navy); }
}
  & .card--full-width__body--img {
  position: relative; display: flex; padding: 0px;
  & .card__body__content {
  & h3, & h3 > a { color: var(--color-brand-core-blue, #00629b); }
  & address { text-decoration: underline; }
  padding: 1rem 2rem;
  & .is-open {
  text-transform: uppercase;
  & span { font: inherit; }
}
  & .btn { display: block; }
}
}
}

.tile {
  border-radius: 16px; padding: 1rem; background-color: var(--color-brand-c=
ore-blue);
  & p, & span, & svg { color: rgb(255, 255, 255); }
  transition: background-color 0.3s ease-out;
  &:hover, &:has(a.tile__link-target:focus) { background-color: var(--color=
-brand-core-navy); }
  &.white-bg {
  background-color: rgb(255, 255, 255); border: 1px solid var(--color-brand=
-neutral-stone, #b6b1a9);
  & h3, & a { color: var(--color-brand-core-blue, #00629b); }
  & p, & span { color: rgb(51, 51, 51); }
  & svg { color: var(--color-brand-accent-magenta, #d462ad); }
  &:hover, &:has(a.tile__link-target:focus) { background-color: var(--color=
-brand-accent-sand, #f5f0e6 ); }
}
  & .tile__body { height: fit-content; padding-block-end: 0px; }
  & .tile__image {
  width: 60px;
  & img { width: 100%; }
}
  & .tile__cta { padding: 6px 6px 0px; background: rgb(216, 216, 216); widt=
h: fit-content; margin-inline-start: auto; }
}

.tag, a.tag {
  border-radius: var(--corner-radius-brand) 0px; padding: 4px 8px; display:=
 inline-block;
  &.magenta { border: 2px solid var(--color-brand-accent-magenta); }
  &.magenta--fill { border: 2px solid var(--color-brand-accent-magenta); ba=
ckground-color: var(--color-brand-accent-magenta); }
  &.orange { border: 2px solid var(--color-brand-accent-orange); }
  &.orange--fill { border: 2px solid var(--color-brand-accent-orange); back=
ground-color: var(--color-brand-accent-orange); }
  &.turquoise { border: 2px solid var(--color-brand-accent-turquoise); }
  &.turquoise--fill { border: 2px solid var(--color-brand-accent-turquoise)=
; background-color: var(--color-brand-accent-turquoise); }
  text-decoration: none;
  &:hover { text-decoration: underline; }
}

.search-bar--select {
  display: flex; border: 1px solid rgb(0, 0, 0); border-radius: 15px; overf=
low: clip; container: select-layout / inline-size;
  & input {
  border-width: medium; border-style: none; border-color: currentcolor; bor=
der-image: initial; flex: 1 1 0%;
  &::placeholder { color: rgb(0, 0, 0) !important; }
}
  & .select-container {
  display: flex; align-items: center; position: relative; border-width: med=
